import { useState, useEffect } from 'react';
import { useNotification } from '../contexts/NotificationContext';
import { supabase } from '../lib/supabase';

const flowerTypes = [
  { type: 'rose', emoji: '🌹', name: 'Rose' },
  { type: 'tulip', emoji: '🌷', name: 'Tulip' },
  { type: 'sunflower', emoji: '🌻', name: 'Sunflower' },
  { type: 'blossom', emoji: '🌸', name: 'Blossom' },
  { type: 'hibiscus', emoji: '🌺', name: 'Hibiscus' },
  { type: 'daisy', emoji: '🌼', name: 'Daisy' },
];

const colors = [
  { name: 'pink', label: 'Pink', hex: '#FFB6C1' },
  { name: 'red', label: 'Red', hex: '#FF6B6B' },
  { name: 'yellow', label: 'Yellow', hex: '#FFD93D' },
  { name: 'purple', label: 'Purple', hex: '#DDA0DD' },
  { name: 'white', label: 'White', hex: '#FFFFFF' },
  { name: 'orange', label: 'Orange', hex: '#FFB347' },
];

export const MemoryGarden = () => {
  const { showSnackbar, showConfirm } = useNotification();
  const [flowers, setFlowers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showPlantModal, setShowPlantModal] = useState(false);
  const [selectedFlower, setSelectedFlower] = useState(null);
  const [newFlower, setNewFlower] = useState({
    flower_type: 'rose',
    color: 'pink',
    message: '',
  });

  useEffect(() => {
    loadFlowers();
  }, []);

  const loadFlowers = async () => {
    setLoading(true);
    try {
      const { data, error } = await supabase
        .from('memory_flowers')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;
      setFlowers(data || []);
    } catch (error) {
      console.error('Error loading flowers:', error);
      showSnackbar('Failed to load flowers', 'error');
    } finally {
      setLoading(false);
    }
  };

  const plantFlower = async () => {
    if (!newFlower.message.trim()) {
      showSnackbar('Please add a message for your flower', 'warning');
      return;
    }

    const position_x = Math.floor(Math.random() * 80) + 10;
    const position_y = Math.floor(Math.random() * 80) + 10;

    try {
      const { error } = await supabase
        .from('memory_flowers')
        .insert({
          flower_type: newFlower.flower_type,
          color: newFlower.color,
          message: newFlower.message,
          position_x,
          position_y,
        });

      if (error) throw error;

      setShowPlantModal(false);
      setNewFlower({ flower_type: 'rose', color: 'pink', message: '' });
      showSnackbar('Flower planted successfully', 'success');
      loadFlowers();
    } catch (error) {
      console.error('Error planting flower:', error);
      showSnackbar('Failed to plant flower', 'error');
    }
  };

  const deleteFlower = (id) => {
    showConfirm(
      'Remove Flower?',
      'This flower will be removed from your garden. This action cannot be undone.',
      async () => {
        try {
          const { error } = await supabase
            .from('memory_flowers')
            .delete()
            .eq('id', id);

          if (error) throw error;

          setSelectedFlower(null);
          showSnackbar('Flower removed from garden', 'success');
          loadFlowers();
        } catch (error) {
          console.error('Error deleting flower:', error);
          showSnackbar('Failed to remove flower', 'error');
        }
      },
      '🌸'
    );
  };

  const getFlowerEmoji = (type) => {
    return flowerTypes.find((f) => f.type === type)?.emoji || '🌸';
  };

  const formatDate = (dateString) => {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  };

  if (loading) {
    return (
      <div className="min-h-[calc(100vh-80px)] px-6 py-12">
        <div className="text-center text-[#666666] text-xl">Growing your garden...</div>
      </div>
    );
  }

  return (
    <div className="min-h-[calc(100vh-80px)] px-6 py-12">
      {/* Header */}
      <div className="text-center mb-12 fade-in">
        <h1 className="text-5xl text-[#2c2c2c] mb-2">Memory Garden</h1>
        <p className="text-xl text-[#666666] font-serif italic">
          Each flower represents a memory, a feeling, or a moment of love
        </p>
      </div>

      {/* Container */}
      <div className="max-w-4xl mx-auto">
        {/* Plant Button */}
        <button
          onClick={() => setShowPlantModal(true)}
          className="flex items-center justify-center gap-3 w-full p-5 bg-gradient-to-r from-[#b8c5b4] to-[#d4e9d4] text-white rounded-lg text-xl font-medium mb-8 hover:-translate-y-1 hover:shadow-xl transition-all fade-in"
        >
          <span className="text-2xl">🌱</span>
          <span>Plant a Flower</span>
        </button>

        {/* Garden Canvas */}
        <div className="relative w-full h-[500px] bg-gradient-to-b from-[#E8F4EA] to-[#C8E6C9] rounded-lg overflow-hidden shadow-inner mb-4">
          {flowers.length === 0 ? (
            <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center w-4/5 max-w-md px-4 fade-in">
              <p className="text-lg leading-relaxed text-[#666666]">
                Your garden is ready for its first flower.
              </p>
              <p className="text-lg leading-relaxed text-[#666666]">
                Plant one to start growing your memories.
              </p>
            </div>
          ) : (
            flowers.map((flower, index) => (
              <button
                key={flower.id}
                className="absolute text-4xl p-2 hover:scale-125 hover:drop-shadow-lg transition-all fade-in"
                style={{
                  left: `${flower.position_x}%`,
                  top: `${flower.position_y}%`,
                  transform: 'translate(-50%, -50%)',
                  animationDelay: `${index * 0.1}s`,
                }}
                onClick={() => setSelectedFlower(flower)}
                title={flower.message}
              >
                {getFlowerEmoji(flower.flower_type)}
              </button>
            ))
          )}
        </div>

        {/* Stats */}
        <div className="text-center bg-white p-4 rounded-lg fade-in">
          <p className="flex items-center justify-center gap-2 text-lg text-[#2c2c2c]">
            <span className="text-2xl">🌸</span>
            <span>
              {flowers.length} flower{flowers.length !== 1 ? 's' : ''} planted
            </span>
          </p>
        </div>
      </div>

      {/* Plant Modal */}
      {showPlantModal && (
        <div
          className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-6 animate-fade-in"
          onClick={() => setShowPlantModal(false)}
        >
          <div
            className="bg-white rounded-lg p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto relative shadow-2xl"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Close Button */}
            <button
              className="absolute top-4 right-4 w-10 h-10 rounded-full bg-[#ffe5d9] text-[#2c2c2c] text-2xl flex items-center justify-center hover:bg-[#ffcab0] hover:rotate-90 transition-all"
              onClick={() => setShowPlantModal(false)}
            >
              ✕
            </button>

            <h2 className="text-3xl text-[#2c2c2c] mb-2">Plant a Flower</h2>
            <p className="text-[#666666] mb-8">
              Choose a flower that represents your memory
            </p>

            {/* Flower Type */}
            <div className="mb-8">
              <label className="block font-medium text-[#2c2c2c] mb-2">Flower Type</label>
              <div className="grid grid-cols-3 gap-2">
                {flowerTypes.map((flower) => (
                  <button
                    key={flower.type}
                    className={`flex flex-col items-center gap-1 p-4 rounded-lg border-2 transition-all ${
                      newFlower.flower_type === flower.type
                        ? 'bg-[#d4e9d4] border-[#b8c5b4]'
                        : 'bg-[#fff8f0] border-transparent hover:bg-[#ffe5d9]'
                    }`}
                    onClick={() =>
                      setNewFlower({ ...newFlower, flower_type: flower.type })
                    }
                  >
                    <span className="text-3xl">{flower.emoji}</span>
                    <span className="text-sm text-[#2c2c2c]">{flower.name}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Color */}
            <div className="mb-8">
              <label className="block font-medium text-[#2c2c2c] mb-2">Color</label>
              <div className="flex gap-2 flex-wrap">
                {colors.map((color) => (
                  <button
                    key={color.name}
                    className={`w-12 h-12 rounded-full border-3 shadow-md transition-all ${
                      newFlower.color === color.name
                        ? 'border-[#b8c5b4] scale-115'
                        : 'border-transparent hover:scale-110'
                    }`}
                    style={{ backgroundColor: color.hex }}
                    onClick={() =>
                      setNewFlower({ ...newFlower, color: color.name })
                    }
                    title={color.label}
                  />
                ))}
              </div>
            </div>

            {/* Message */}
            <div className="mb-8">
              <label className="block font-medium text-[#2c2c2c] mb-2">
                Memory or Message
              </label>
              <textarea
                placeholder="What does this flower represent?..."
                value={newFlower.message}
                onChange={(e) =>
                  setNewFlower({ ...newFlower, message: e.target.value })
                }
                rows={4}
                className="w-full p-4 border-2 border-[#ffe5d9] rounded-lg font-serif leading-relaxed resize-y bg-[#fff8f0] focus:border-[#b8c5b4] focus:bg-white transition-all"
              />
            </div>

            {/* Submit Button */}
            <button
              onClick={plantFlower}
              className="w-full p-4 bg-gradient-to-r from-[#b8c5b4] to-[#d4e9d4] text-white rounded-lg text-lg font-medium hover:-translate-y-1 hover:shadow-xl transition-all"
            >
              Plant This Flower
            </button>
          </div>
        </div>
      )}

      {/* Flower Detail Modal */}
      {selectedFlower && (
        <div
          className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-6 animate-fade-in"
          onClick={() => setSelectedFlower(null)}
        >
          <div
            className="bg-white rounded-lg p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto relative shadow-2xl"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Close Button */}
            <button
              className="absolute top-4 right-4 w-10 h-10 rounded-full bg-[#ffe5d9] text-[#2c2c2c] text-2xl flex items-center justify-center hover:bg-[#ffcab0] hover:rotate-90 transition-all"
              onClick={() => setSelectedFlower(null)}
            >
              ✕
            </button>

            {/* Header */}
            <div className="text-center mb-8 pb-6 border-b-2 border-[#ffe5d9]">
              <div className="text-8xl mb-4">
                {getFlowerEmoji(selectedFlower.flower_type)}
              </div>
              <p className="text-[#666666] text-sm">
                Planted on {formatDate(selectedFlower.created_at)}
              </p>
            </div>

            {/* Body */}
            <div className="mb-8">
              <p className="text-xl text-[#2c2c2c] leading-relaxed font-serif whitespace-pre-wrap">
                {selectedFlower.message}
              </p>
            </div>

            {/* Delete Button */}
            <button
              onClick={() => deleteFlower(selectedFlower.id)}
              className="w-full p-4 bg-[#ffb3c1] text-[#2c2c2c] rounded-lg font-medium hover:bg-[#F0A0A0] hover:-translate-y-1 transition-all"
            >
              Remove Flower
            </button>
          </div>
        </div>
      )}
    </div>
  );
};
